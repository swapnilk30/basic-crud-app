# ==============================================================
# Basic CRUD App — Monorepo .gitignore
# Layout:
#   backend/basic-crud-app/   (Spring Boot + Maven)
#   frontend/react-js/        (React + Vite, JavaScript)
#   frontend/react-ts/        (React + Vite, TypeScript)
# ==============================================================

# ==============================
# General
# ==============================
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo

# ==============================
# Java / Maven (backend/**)
# ==============================
# Any target/ dir at any depth (e.g., backend/basic-crud-app/target/)
**/target/

# Keep the Maven wrapper (must be tracked for CI)
!**/mvnw
!**/mvnw.cmd
!**/.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.properties

# Maven helper files
**/.mvn/timing.properties
dependency-reduced-pom.xml

# Java compiled output
*.class
*.jar
*.war
*.ear
*.nar

# Spring Boot local overrides (never commit secrets)
application-local.properties
application-local.yml
application-*-local.properties
application-*-local.yml

# Spring Boot logs
**/spring.log

# ==============================
# Node / React (frontend/**)
# ==============================
# Recursive — covers react-js, react-ts, and any future app
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.cache/
**/.parcel-cache/
**/.eslintcache
**/.stylelintcache

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript build info (react-ts)
**/*.tsbuildinfo

# Vite env files (may contain secrets)
**/.env
**/.env.local
**/.env.*.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Storybook (if added later)
**/storybook-static/

# ==============================
# Environment / Secrets (root)
# ==============================
.env
.env.local
.env.*.local

# ==============================
# Databases / Runtime
# ==============================
# H2 file-mode artifacts
*.mv.db
*.trace.db
*.lock.db

# H2 default data folder (if you switch to file mode)
/data/

# ==============================
# IDEs / Editors
# ==============================
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.project
.classpath
.settings/
.factorypath
nbproject/private/

# ==============================
# OS / Temp
# ==============================
*~
\#*\#
.\#*

# ==============================
# Build tool caches
# ==============================
.gradle/
build/
!**/src/**/build/

# ==============================
# Test / Coverage outputs
# ==============================
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/